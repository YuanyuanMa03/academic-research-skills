{
  "name": "gs-navigate-pages",
  "version": "1.0.0",
  "author": {
    "name": "YuanyuanMa03"
  },
  "license": "MIT",
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--ignoreDefaultChromeArg=--enable-automation",
        "--ignoreDefaultChromeArg=--disable-infobars",
        "--chromeArg=--disable-blink-features=AutomationControlled"
      ]
    }
  },
  "description": "Navigate Google Scholar search result pages. Use when user wants to see more results or go to a specific page."
}
