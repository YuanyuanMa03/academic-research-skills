      "name": "cnki-search",
      "source": {
        "source": "local",
        "path": "./plugins/cnki-search"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Research",
      "description": "Search CNKI (中国知网) for papers by keyword. Use when the user wants to find academic papers on a topic."
    },
    {
